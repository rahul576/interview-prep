{
  "name": "interviewpro",
  "version": "1.4.1",
  "private": true,
  "description": "InterviewPro V1 - realistic AI-style mock interviews (offline question bank) for web, Android and iOS tablets",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "cap:add": "npx cap add android && npx cap add ios && node scripts/patch-native.mjs",
    "cap:sync": "npx cap sync && node scripts/patch-native.mjs",
    "android": "npx cap open android",
    "ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor-community/speech-recognition": "^7.0.0",
    "@capacitor-community/text-to-speech": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "playwright": "^1.48.0"
  }
}
